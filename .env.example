# ==========================================================================
# SANAÉRA — Environment Variables
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==========================================================================

# --- Database (Neon or Supabase Postgres) ---------------------------------
# DATABASE_URL: pooled connection string (used at runtime, e.g. Neon's pooler
# or Supabase's "Transaction" pooler on port 6543).
DATABASE_URL="postgresql://neondb_owner:npg_bWo9ykQDOa0x@ep-wispy-cloud-ax9ci7hs-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# DIRECT_URL: unpooled connection, required by Prisma Migrate.
DIRECT_URL="postgresql://neondb_owner:npg_bWo9ykQDOa0x@ep-wispy-cloud-ax9ci7hs.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# --- Auth.js ---------------------------------------------------------------
# Generate with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET="45dc2e59b4d6ccf8320a15b30904ede084b24f828ceca3a252d2d0cf2543d3ed"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Cloudinary (product/avatar/banner image uploads) ----------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Public unsigned upload preset, if you want client-side direct uploads too:
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# --- Razorpay ---------------------------------------------------------------
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# --- Email (Nodemailer via SMTP, e.g. Postmark / SES / Resend SMTP) --------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="SANAÉRA <hello@sanaera.com>"

# --- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Rate limiting (optional — Upstash Redis, used by middleware) ----------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Cron (Vercel Cron Jobs — low-stock check) ------------------------------
# Set this in Vercel's project env vars too; Vercel automatically sends
# `Authorization: Bearer $CRON_SECRET` on scheduled cron requests once it's set.
CRON_SECRET=""
